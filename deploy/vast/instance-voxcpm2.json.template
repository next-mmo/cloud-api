{
  "image": "YOUR_REGISTRY/voxcpm2-worker:latest",
  "disk": 40,
  "label": "voxcpm2-worker",
  "runtype": "args",
  "args_str": "/app/start.sh",
  "env": {
    "ENGINE_MODE": "real",
    "MODEL_PATH": "/models/VoxCPM2",
    "PRELOAD_MODEL": "0",
    "PORT": "8011",
    "SALAD_QUEUE_WORKER_ENABLED": "0",
    "RUNPOD_HANDLER_ENABLED": "0",
    "STORAGE_PROVIDER": "inline",
    "-p 8011:8011": "1"
  }
}
