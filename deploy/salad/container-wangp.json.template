{
  "name": "wangp-worker",
  "display_name": "WanGP Worker",
  "autostart_policy": true,
  "restart_policy": "always",
  "container": {
    "image": "YOUR_REGISTRY/wangp-worker:latest",
    "image_caching": true,
    "resources": {
      "cpu": 8,
      "memory": 32768,
      "gpu_classes": [
        "REPLACE_WITH_GPU_CLASS_UUID"
      ]
    },
    "environment_variables": {
      "WANGP_ROOT": "/opt/Wan2GP",
      "WANGP_OUTPUT_DIR": "/outputs",
      "WANGP_CLI_ARGS": "--attention,sdpa,--profile,4",
      "PRELOAD_MODEL": "0",
      "PORT": "8012",
      "SALAD_QUEUE_WORKER_ENABLED": "1",
      "SALAD_QUEUE_WORKER_LOG_LEVEL": "info",
      "STORAGE_PROVIDER": "google_drive",
      "GOOGLE_DRIVE_CLIENT_ID": "REPLACE_ME",
      "GOOGLE_DRIVE_CLIENT_SECRET": "REPLACE_ME",
      "GOOGLE_DRIVE_REFRESH_TOKEN": "REPLACE_ME",
      "GOOGLE_DRIVE_FOLDER_ID": "REPLACE_ME",
      "GOOGLE_DRIVE_MAKE_PUBLIC": "false"
    }
  },
  "replicas": 0,
  "country_codes": [
    "us",
    "ca"
  ],
  "startup_probe": {
    "http": {
      "path": "/health",
      "port": 8012
    },
    "initial_delay_seconds": 30,
    "period_seconds": 15,
    "timeout_seconds": 5,
    "failure_threshold": 40,
    "success_threshold": 1
  },
  "readiness_probe": {
    "http": {
      "path": "/ready",
      "port": 8012
    },
    "initial_delay_seconds": 5,
    "period_seconds": 20,
    "timeout_seconds": 10,
    "failure_threshold": 6,
    "success_threshold": 1
  },
  "queue_connection": {
    "path": "/process",
    "port": 8012,
    "queue_name": "wangp-jobs"
  },
  "queue_autoscaler": {
    "min_replicas": 0,
    "max_replicas": 1,
    "desired_queue_length": 1,
    "polling_period": 30,
    "max_upscale_per_minute": 1,
    "max_downscale_per_minute": 1
  }
}
