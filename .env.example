# Controller
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./data/app.db
PUBLIC_BASE_URL=http://localhost:8000
LOCAL_STORAGE_DIR=./data/files

# Direct/local workers
VOX_WORKER_URL=http://voxcpm2-worker:8011
WAN_WORKER_URL=http://wangp-worker:8012
CUSTOM_WORKER_URL=
CUSTOM_WORKER_TOKEN=

# SaladCloud (server side only)
SALAD_API_KEY=
SALAD_ORGANIZATION=
SALAD_PROJECT=
SALAD_VOX_QUEUE=voxcpm2-jobs
SALAD_WAN_QUEUE=wangp-jobs
SALAD_VOX_GROUP=voxcpm2-inline-demo
SALAD_GPU_CLASS=
SALAD_VOX_CPU=4
SALAD_VOX_MEMORY_MB=32768
VOXCPM2_IMAGE=ghcr.io/next-mmo/cloud-api-voxcpm2:inline-demo
SALAD_WEBHOOK_BASE_URL=
SALAD_WEBHOOK_SECRET=

# RunPod Serverless (optional)
RUNPOD_API_KEY=
RUNPOD_VOX_ENDPOINT_ID=
RUNPOD_WAN_ENDPOINT_ID=
RUNPOD_HANDLER_ENABLED=0

# Clore.ai marketplace rentals (optional; use custom worker URL after deploy)
CLORE_API_KEY=
CLORE_SERVER_ID=
CLORE_WORKER_URL=
CLORE_MAX_USD_PER_HOUR=
CLORE_MIN_RAM_GB=24

# Vast.ai GPU cloud rentals (optional; use custom worker URL after deploy)
# https://vast.ai/ — API key from https://cloud.vast.ai/manage-keys/
# Image defaults to VOXCPM2_IMAGE above when instance JSON still has a placeholder.
VAST_API_KEY=
VAST_OFFER_ID=
VAST_INSTANCE_ID=
VAST_WORKER_URL=
VAST_GPU_NAME=RTX 4090
VAST_MAX_USD_PER_HOUR=
VAST_MIN_RAM_GB=24
VAST_NUM_GPUS=1
# Required if VOXCPM2_IMAGE is a private ghcr.io/Docker Hub image
# Example: -u USER -p ghp_xxx ghcr.io
VAST_IMAGE_LOGIN=

# R2 / S3-compatible storage
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Google Drive storage (OAuth refresh-token flow)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_MAKE_PUBLIC=false

# Worker settings
ENGINE_MODE=mock
MODEL_PATH=openbmb/VoxCPM2
WANGP_ROOT=/opt/Wan2GP
WANGP_OUTPUT_DIR=/outputs
WANGP_CLI_ARGS=--attention,sdpa,--profile,4
SALAD_QUEUE_WORKER_ENABLED=0
