FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04
ARG DEBIAN_FRONTEND=noninteractive
ARG WANGP_REF=main
ARG CUDA_ARCHITECTURES="8.6;8.9"
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev git ffmpeg curl wget ca-certificates \
    cmake ninja-build libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /opt
RUN git init Wan2GP && \
    cd Wan2GP && \
    git remote add origin https://github.com/deepbeepmeep/Wan2GP.git && \
    git fetch --depth 1 origin "$WANGP_REF" && \
    git checkout FETCH_HEAD
WORKDIR /opt/Wan2GP
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    python3 -m pip install --no-cache-dir \
      torch==2.10.0+cu128 torchvision==0.25.0+cu128 torchaudio==2.10.0+cu128 \
      --index-url https://download.pytorch.org/whl/cu128 && \
    python3 -m pip install --no-cache-dir -r requirements.txt
COPY packages/python_common /opt/python_common
COPY workers/common/requirements.txt /tmp/common.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/common.txt
RUN curl -fsSL https://github.com/SaladTechnologies/salad-cloud-job-queue-worker/releases/download/v0.5.0/salad-http-job-queue-worker_x86_64.tar.gz | \
    tar -xz -C /usr/local/bin && chmod +x /usr/local/bin/salad-http-job-queue-worker
WORKDIR /app
RUN python3 -m pip install --no-cache-dir 'runpod>=1.7,<2'

COPY workers/common/worker_base.py /app/worker_base.py
COPY workers/common/runpod_handler.py /app/runpod_handler.py
COPY workers/common/start.sh /app/start.sh
COPY workers/wangp/app /app/app
RUN chmod +x /app/start.sh && mkdir -p /outputs /app/data/files
ENV PYTHONPATH=/opt/Wan2GP:/app \
    PORT=8012 \
    ENGINE_MODE=real \
    WANGP_ROOT=/opt/Wan2GP \
    WANGP_OUTPUT_DIR=/outputs \
    SALAD_QUEUE_WORKER_ENABLED=1 \
    TORCH_CUDA_ARCH_LIST=${CUDA_ARCHITECTURES}
EXPOSE 8012
CMD ["/app/start.sh"]
